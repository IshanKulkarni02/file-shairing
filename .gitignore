# Dependencies
node_modules/

# Generated at first run: contains the session secret and password hashes.
config.json

# The media library itself and the server's own cache/trash.
library/
.lanshare/

# Server-level state next to config.json: session records, independent of
# wherever the library happens to live.
.lanshare-server/

# Packaged output and staged binaries.
# vendor/ holds ~370 MB of ffmpeg and libvips copied in by build.js.
dist/
build/
bin/
vendor/

# TLS material, if you enable HTTPS
*.pem
*.key
*.crt

# OS and editor noise
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
*.log
npm-debug.log*
